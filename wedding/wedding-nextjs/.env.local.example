# Copy this file to .env.local and fill in your project's values.

# Public — safe to expose in the browser. Used by the RSVP form.
# Find these in Supabase: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — NEVER expose this in the browser or commit it.
# Also in Supabase: Project Settings → API → service_role key.
# Used only by the /dashboard route (running on the server) to read RSVPs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The password for /dashboard. Choose your own — this is not from Supabase.
DASHBOARD_PASSWORD=choose-a-strong-password
